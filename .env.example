# Model must support tool calling and the OpenAI-compatible chat API.
AGENT_MODEL=
AGENT_MODEL_BASE_URL=https://api.openai.com/v1
AGENT_MODEL_API_KEY=

# WeKnora's endpoint token and user JWT are issued by WeKnora, not this Agent.
WEKNORA_MCP_URL=http://127.0.0.1:18082/mcp/REPLACE_WITH_ENDPOINT_ID
WEKNORA_MCP_TOKEN=
WEKNORA_USER_TOKEN=
WEKNORA_WORKSPACE_ID=
# 1-10 explicit knowledge-base UUIDs, comma-separated; the server checks access.
WEKNORA_KB_IDS=

# Optional: the file the credential issuer (examples/mcp-validation/scripts/
# issue_user_token.py, or scripts/refresh-credential.ps1) writes. Set it to let
# the console's 「读取本机凭证」 button read that file; the route answers "not
# enabled" when it is unset, because the console has no default credential path.
WEKNORA_CREDENTIAL_FILE=

# Console port (default 18100).
WEKNORA_AGENT_WEB_PORT=18100
